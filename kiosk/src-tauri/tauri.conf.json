{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "steward-kiosk",
  "version": "0.5.0",
  "identifier": "io.github.danielterletzkiy.steward-kiosk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Steward",
    "homepage": "https://github.com/DanielTerletzkiy/steward",
    "category": "Utility",
    "shortDescription": "Steward kitchen terminal",
    "longDescription": "Shows Steward's kiosk page full screen on a Raspberry Pi in the kitchen: scan what you use up, add what came without a receipt, see chores and recipes. Pairs Bluetooth barcode scanners and turns the screen off when nobody uses it.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "misc",
        "depends": ["libdbus-1-3"],
        "recommends": [
          "bluez",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "wlopm | x11-xserver-utils"
        ],
        "desktopTemplate": "steward-kiosk.desktop"
      }
    }
  }
}
